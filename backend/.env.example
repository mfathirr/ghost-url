# Production Backend Configuration
PORT=8080
GIN_MODE=release

# Redis connection string (e.g., Upstash, Redis Cloud, or Docker internal)
# Local Docker: redis://redis:6379
# Managed Redis with TLS: rediss://default:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379
REDIS_POOL_SIZE=10

# Public URL of the service (used when generating visitable short links)
# For production: https://ghost.yourdomain.com
BASE_URL=http://localhost:5173

# Frontend origin allowed for CORS requests
FRONTEND_URL=http://localhost:5173
